{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "expense-splitter",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-15",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      // Self-reference service binding used by the OpenNext runtime.
      // "service" must match the worker "name" above.
      "binding": "WORKER_SELF_REFERENCE",
      "service": "expense-splitter"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "expense-splitter",
      // Real D1 database created in the Cloudflare dashboard (migrations/0001_init.sql applied via
      // the D1 console). Local `next dev` ignores this id and uses a simulated database.
      "database_id": "498037aa-01db-4b3f-9735-37635ecdd1f0",
      "migrations_dir": "migrations"
    }
  ]
}
